// The site at street-complete-statistics.comentality.com: docs/ as Workers static assets, and no
// script. Deploy: see cloudflare/README.md (the daily run does it).
//
// There is deliberately no `main`. Cloudflare serves a file that matches the path without running a
// Worker, and with no script a path that matches nothing is a plain 404, so no request to this site
// counts against Workers Free's 100,000 a day and a traffic spike has no cap to spend.
// wrangler.r2.jsonc is the earlier shape (a Worker reading the R2 bucket) and the way back.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sc-open-quests",
  "compatibility_date": "2026-10-01",
  "account_id": "699ef919f465c0a729552780cdb6c27f",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "street-complete-statistics.comentality.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../docs",
    // Files are served at their exact path only. The comentality.com zone has a URL Rewrite rule,
    // "Serve index.html for folder paths", that turns every path ending in "/" into ".../index.html"
    // before the assets see it; with "auto-trailing-slash" the assets answered that "/index.html" with
    // a 307 to "/", a loop. "/" itself is served by docs/_redirects ("/ /index.html 200"), so the home
    // page works with or without that rule.
    "html_handling": "none",
    // a missing file is a real 404, never index.html, so a chart that asks for a city the archive
    // lacks fails the way it did on Pages
    "not_found_handling": "none"
  }
}
