// The site at street-complete-statistics.comentality.com, deployed by the daily run (cloudflare/README.md):
// docs/ as Workers static assets plus one script (src/site.js) that runs for the page itself and writes a
// place's title and description into its head (share previews, live since 2026-11-27). It needs Workers
// Paid: the script parses a city's history, past Workers Free's 10 ms of CPU, and each page view is a
// request. wrangler.static.jsonc is the same site with no script, the way back; wrangler.r2.jsonc the
// earlier shape (a Worker reading the R2 bucket).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sc-open-quests",
  "main": "src/site.js",
  "compatibility_date": "2026-10-01",
  "account_id": "699ef919f465c0a729552780cdb6c27f",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "street-complete-statistics.comentality.com", "custom_domain": true }
  ],
  "vars": {
    // the world's place files (docs/app.js WORLD_HOST); "" leaves world places with the site's own head
    "WORLD_HOST": "https://sc-data.comentality.com/"
  },
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    // Files are served at their exact path only. The comentality.com zone has a URL Rewrite rule,
    // "Serve index.html for folder paths", that turns every path ending in "/" into ".../index.html"
    // before the assets see it; with "auto-trailing-slash" the assets answered that "/index.html" with
    // a 307 to "/", a loop. "/" itself is served by docs/_redirects ("/ /index.html 200").
    // A missing file is a real 404, never index.html.
    "html_handling": "none",
    "not_found_handling": "none",
    // The script runs for these two paths only ("/index.html" is what the zone's rewrite rule makes of
    // "/"). Every other path that matches a file is served without it, free and uncounted; a path that
    // matches nothing reaches the script, which hands it back to the assets for their 404.
    "run_worker_first": ["/", "/index.html"]
  }
}
