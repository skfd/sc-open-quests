// The site with share previews: docs/ as static assets, as wrangler.jsonc has it, plus one script
// (src/site.js) that runs for the page itself and writes a place's title and description into its head.
// NOT the deployed shape yet: the daily run deploys wrangler.jsonc. Going live is cloudflare/README.md,
// "Share previews"; it needs Workers Paid first (the script parses a city's history, past Workers
// Free's 10 ms of CPU, and each page view is a request against Free's 100,000 a day).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sc-open-quests",
  "main": "src/site.js",
  "compatibility_date": "2026-10-01",
  "account_id": "699ef919f465c0a729552780cdb6c27f",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "street-complete-statistics.comentality.com", "custom_domain": true }
  ],
  "vars": {
    // the world's place files (docs/app.js WORLD_HOST); "" leaves world places with the site's own head
    "WORLD_HOST": "https://sc-data.comentality.com/"
  },
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    // see wrangler.jsonc for both
    "html_handling": "none",
    "not_found_handling": "none",
    // The script runs for these two paths only ("/index.html" is what the zone's rewrite rule makes of
    // "/"). Every other path that matches a file is served without it, free and uncounted; a path that
    // matches nothing reaches the script, which hands it back to the assets for their 404.
    "run_worker_first": ["/", "/index.html"]
  }
}
