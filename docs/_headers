# Response headers for the site on Cloudflare (Workers static assets read this file; it is not served).
# Everything else keeps Cloudflare's default, "max-age=0, must-revalidate": the browser asks each time
# and gets a 304 when its copy is current, so a fresh daily run shows at once.

# Quest icons and images change only with an app repin; readers keep them a day.
/icons/*
  Cache-Control: public, max-age=86400

/img/*
  Cache-Control: public, max-age=86400

# The page's libraries sit in versioned folders (docs/vendor/README.md): a new version is a new path.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
