// Append to StreetComplete's app/build.gradle.kts (tested at tag v63.4).
//
// v63.x and older: unit tests live in app/src/androidUnitTest and the test task is "testDebugUnitTest".
// Newer master:    they live in app/src/androidHostTest and the test task is "testAndroidHostTest"
//                  (see master's printQuestFiltersAsOverpassQL task, which this is modelled on).
// Change the task names below (and the source folder you drop the .kt files into) accordingly.

// sc-open-quests harness: dump every quest type with its resolved element filter as JSON.
// Usage: ./gradlew :app:dumpQuestFilters -PdumpOut=/path/to/v63.4.json
tasks.register<JavaExec>("dumpQuestFilters") {
    group = "utils"

    val testTask = tasks.named<Test>("testDebugUnitTest")
    // no dependsOn(testTask...): that would run the unit tests too; the classpath carries its own build deps
    classpath = testTask.get().classpath

    mainClass.set("de.westnordost.streetcomplete.DumpQuestFiltersKt")

    systemProperty("sc.version", appVersionName)
    systemProperty("sc.commit", providers.exec {
        commandLine("git", "rev-parse", "HEAD")
    }.standardOutput.asText.get().trim())
    (findProperty("dumpOut") as String?)?.let { systemProperty("sc.out", it) }
}

// sc-open-quests harness: oracle for ported custom quests. Runs the real getApplicableElements() of the
// given quest types over a JSON-lines element file and writes the applicable elements as TSV.
// Usage: ./gradlew :app:checkCustomQuests -PcheckIn=elements.jsonl -PcheckQuests=AddSidewalk,AddOpeningHours -PcheckOut=out.tsv
//        [-PcheckBbox=south,west,north,east]
tasks.register<JavaExec>("checkCustomQuests") {
    group = "utils"

    val testTask = tasks.named<Test>("testDebugUnitTest")
    // no dependsOn(testTask...): that would run the unit tests too; the classpath carries its own build deps
    classpath = testTask.get().classpath

    mainClass.set("de.westnordost.streetcomplete.CheckCustomQuestsKt")
    maxHeapSize = "20g"

    (findProperty("checkIn") as String?)?.let { systemProperty("sc.in", it) }
    (findProperty("checkQuests") as String?)?.let { systemProperty("sc.quests", it) }
    (findProperty("checkOut") as String?)?.let { systemProperty("sc.out", it) }
    (findProperty("checkPresets") as String?)?.let { systemProperty("sc.presets", it) }
    (findProperty("checkBbox") as String?)?.let { systemProperty("sc.bbox", it) }
    // getFeature() reads osmfeatures in the default locale; the engine pins en-CA too
    systemProperty("user.language", "en")
    systemProperty("user.country", "CA")
}
